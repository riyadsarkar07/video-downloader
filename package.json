{
  "name": "universal-media-downloader",
  "version": "2.0.0",
  "private": true,
  "description": "A real video downloader with a Next.js frontend and a yt-dlp Node.js backend.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "backend": "npm --prefix backend start",
    "backend:dev": "npm --prefix backend run dev",
    "test": "npm run test:frontend && npm run test:backend",
    "test:frontend": "node --test test/frontend.test.mjs test/proxy.test.mjs",
    "test:backend": "npm --prefix backend test",
    "test:integration": "node --test test/integration.test.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "lucide-react": "^0.475.0",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sonner": "^1.7.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=18.17.0"
  }
}
