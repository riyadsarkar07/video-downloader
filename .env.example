# Optional: YouTube cookie string to bypass bot-detection ("Sign in to confirm you're not a bot").
# Copy a cookie header from a logged-in YouTube browser session.
# Format: name1=value1; name2=value2; ...
# If unset, extraction still works but may be limited/blocked on datacenter IPs,
# in which case the built-in Cobalt fallback is used automatically.
YOUTUBE_COOKIE=

# Optional: override the Cobalt API endpoint used as the YouTube extraction fallback.
# The legacy https://api.cobalt.tools/api/json (v7) was shut down on Nov 11 2024.
# Point this at a working Cobalt v10 API instance you are allowed to use, e.g.:
# COBALT_API_URL=https://your-cobalt-instance.example/api/json
# If unset, defaults to https://api.cobalt.tools/api/json
COBALT_API_URL=

# Optional: API key for Cobalt instances that require one (sent as Authorization: Bearer <key>).
COBALT_API_KEY=
