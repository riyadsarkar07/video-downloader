# Frontend
# URL of the dedicated download API. Used by the Next.js /api proxy routes.
# On Vercel set this to the public HTTPS backend origin, e.g. https://api.example.com
BACKEND_URL=http://127.0.0.1:3001

# Backend
PORT=3001
HOST=0.0.0.0
# Trusted proxies for X-Forwarded-For: a hop count, "loopback", or "false".
# Default trusts only loopback, which fits the bundled Next.js /api proxy.
# Behind Caddy/Compose use 1. Behind the local start.sh proxy, keep loopback.
TRUST_PROXY=loopback
YTDLP_BIN=yt-dlp
FFMPEG_BIN=/usr/bin/ffmpeg

# Optional cookies file for sites that require a logged-in session.
# Must be an operator-owned file mounted read-only. Never commit this file.
YTDLP_COOKIES=

# Optional temp directory for processed files.
# In Docker Compose this is /tmp/unidown backed by a named volume.
DOWNLOAD_TMP_DIR=

# Comma-separated list of browser origins allowed to call the API cross-origin.
# Leave empty when the frontend proxies /api (same-origin). Example:
# CORS_ORIGINS=https://unidown.example.com,https://www.unidown.example.com
CORS_ORIGINS=

# Timeouts and limits
EXTRACT_TIMEOUT_MS=45000
DOWNLOAD_TIMEOUT_MS=300000
JOB_TTL_MS=900000
MAX_CONCURRENT_JOBS=2
MAX_QUEUED_JOBS=40
MAX_FILESIZE=500M
MAX_DURATION_SEC=10800

# Per-IP rate limits (requests per minute)
EXTRACT_RATE_LIMIT=20
DOWNLOAD_RATE_LIMIT=8
FILE_RATE_LIMIT=60

# Reverse proxy (docker-compose.yml + deploy/Caddyfile only)
# Public hostname Caddy obtains a certificate for, and the ACME contact email.
API_DOMAIN=api.example.com
ACME_EMAIL=admin@example.com
